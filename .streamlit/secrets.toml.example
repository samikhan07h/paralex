# Template for Streamlit Community Cloud's secrets manager.
#
# This is NOT read locally — local development uses .env instead (see
# .env.example). This file only matters once deployed: in the Streamlit
# Community Cloud dashboard, go to your app's Settings -> Secrets, and
# paste in the contents below with your real values filled in. The app's
# startup code (app/streamlit_app.py) bridges these into environment
# variables automatically, so no code changes are needed between local
# and deployed environments.
#
# Never commit a real secrets.toml with actual values — this example file
# is safe to commit precisely because it contains no real key.

GROQ_API_KEY = "gsk_your_actual_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
TOP_K = "2"
