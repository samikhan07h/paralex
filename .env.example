# Copy this file to .env and fill in your own values. Never commit .env itself.

# Groq API key — get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM model to use via Groq
GROQ_MODEL=openai/gpt-oss-120b

# Embedding model (HuggingFace sentence-transformers model id)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking config
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval config
# TOP_K=2 chosen empirically via Phase 2 evaluation — see src/config.py for details
TOP_K=2

# Paths (relative to project root — usually no need to change)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
VECTORSTORE_DIR=data/processed/faiss_index
